{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coldem",
  "version": "0.4.9",
  "identifier": "games.coldem.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coldem",
        "width": 1320,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0d0e0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["coldem"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQzFFNDcyRTBENzBDOEEKUldTS0ROZmdjdVRCcm12VWhOL24wd3BaSFlzUVRzUjQyMTNXdzU5cElSVjJEWEhzMWZQVDFjN2UK",
      "endpoints": [
        "https://github.com/DnCold/Coldem-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "publisher": "DanCold",
    "copyright": "© 2026 DanCold",
    "homepage": "https://github.com/DnCold/Coldem-launcher",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/butler"],
    "resources": {
      "vendor/discord/discord_partner_sdk.dll": "discord/discord_partner_sdk.dll",
      "vendor/discord/discord_krisp.dll": "discord/discord_krisp.dll",
      "vendor/discord/License-Notices.txt": "discord/License-Notices.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "uninstallerHeaderImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "startMenuFolder": "Coldem"
      }
    },
    "shortDescription": "A focused launcher for DanCold games",
    "longDescription": "Browse, install, update, and launch DanCold games from public signed releases."
  }
}
